{
  "name": "rigpoint-load-sheet",
  "version": "0.1.0",
  "description": "RigPoint Load Sheet – static load-path calculation and Load Sheet for a single flown loudspeaker hang.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:spec": "vitest run src/schema/spec-library.test.ts && node scripts/check-spec-version.mjs",
    "reference": "python3 reference/engine_reference.py fixtures/scenarios.json data/spec-library.json",
    "ci": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
